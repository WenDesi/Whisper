<UserControl x:Class="WhisperDesk.Views.SettingsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:WhisperDesk.Views"
             Width="340" Height="300" MaxWidth="400"
             FontFamily="{StaticResource WhisperDesk.Font}"
             Foreground="{DynamicResource WhisperDesk.Brush.Text}"
             Margin="20">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:VolumeToWidthConverter x:Key="VolumeToWidthConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <materialDesign:PackIcon Kind="Cog"
                                     Width="22" Height="22"
                                     VerticalAlignment="Center"
                                     Margin="0,0,12,0"
                                     Foreground="{DynamicResource WhisperDesk.Brush.Accent}" />
            <StackPanel>
                <TextBlock Text="麦克风设置" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="选择要使用的麦克风。" FontSize="12" Margin="0,5,0,0"
                           Foreground="{DynamicResource WhisperDesk.Brush.SecondaryText}" />
            </StackPanel>
        </DockPanel>

        <TextBlock Grid.Row="1" Text="对着麦克风说话，可以查看实时音量。"
                   FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource WhisperDesk.Brush.SecondaryText}"
                   Margin="0,0,0,12" />

        <Grid Grid.Row="2" x:Name="DeviceViewport">
            <StackPanel x:Name="LoadingState" VerticalAlignment="Center"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="正在连接麦克风…" FontSize="12" Margin="0,0,0,12"
                           TextAlignment="Center" AutomationProperties.LiveSetting="Polite"
                           Foreground="{DynamicResource WhisperDesk.Brush.SecondaryText}" />
                <ProgressBar IsIndeterminate="True" Width="160" Height="3"
                             Foreground="{DynamicResource WhisperDesk.Brush.Accent}" />
            </StackPanel>

            <ScrollViewer x:Name="ErrorScrollViewer" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ErrorMessage}" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource WhisperDesk.Brush.Danger}"
                           AutomationProperties.LiveSetting="Polite" />
            </ScrollViewer>

            <ScrollViewer x:Name="DeviceScrollViewer" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding NoDevicesFound}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <ItemsControl ItemsSource="{Binding Devices}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8" Padding="10,12" Margin="0,0,0,6"
                                    Background="{DynamicResource WhisperDesk.Brush.Subtle}"
                                    BorderBrush="{DynamicResource WhisperDesk.Brush.Border}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="72" />
                                    </Grid.ColumnDefinitions>

                                    <RadioButton Grid.Column="0"
                                                 IsChecked="{Binding IsSelected}"
                                                 GroupName="MicrophoneSelection"
                                                 AutomationProperties.Name="{Binding DisplayName}"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,12,0" />

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DisplayName}"
                                               FontSize="12"
                                               ToolTip="{Binding DisplayName}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />

                                    <Grid Grid.Column="2" Height="8"
                                          VerticalAlignment="Center" Margin="12,0,0,0">
                                        <Border Background="{DynamicResource WhisperDesk.Brush.AccentSubtle}" CornerRadius="4" />
                                        <Border Background="{DynamicResource WhisperDesk.Brush.Accent}" CornerRadius="4"
                                                HorizontalAlignment="Left">
                                            <Border.Width>
                                                <MultiBinding Converter="{StaticResource VolumeToWidthConverter}">
                                                    <Binding Path="Volume" />
                                                    <Binding Path="ActualWidth"
                                                             RelativeSource="{RelativeSource AncestorType=Grid}" />
                                                </MultiBinding>
                                            </Border.Width>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Text="未检测到麦克风，请检查设备连接。"
                       FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource WhisperDesk.Brush.SecondaryText}"
                       Visibility="{Binding NoDevicesFound, Converter={StaticResource BoolToVis}}" />
        </Grid>

        <!-- Buttons -->
        <DockPanel Grid.Row="3" Margin="0,20,0,0">
            <Button x:Name="CancelButton" DockPanel.Dock="Right"
                    Style="{StaticResource WhisperDesk.QuietButton}"
                    Content="取消"
                    Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                    CommandParameter="false"
                    Margin="8,0,0,0" />
            <Button x:Name="ApplyButton" DockPanel.Dock="Right"
                    Style="{StaticResource WhisperDesk.PrimaryButton}"
                    Content="应用"
                    Command="{Binding ApplyCommand}" />
            <StackPanel /> <!-- Spacer -->
        </DockPanel>
    </Grid>
</UserControl>
